generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id            String   @id @default(uuid())
  name          String
  location      String?
  contactNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  vehicles    Vehicle[]
  rentals     Rental[]
  customers   Customer[]
  maintenance MaintenanceExpense[]
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("BRANCH") // ADMIN, BRANCH
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([branchId])
}

model Vehicle {
  id              String   @id @default(uuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  vehicleNumber   String   @unique
  vehicleName     String
  vehicleType     String
  hourlyRate      Float
  securityDeposit Float
  rate1hr         Float?
  rate3hr         Float?
  rate6hr         Float?
  rate12hr        Float?
  rate24hr        Float?
  description     String?
  status          String   @default("AVAILABLE") // AVAILABLE, RENTED, INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rentals     Rental[]
  maintenance MaintenanceExpense[]

  @@index([branchId])
  @@index([status])
}

model Customer {
  id            String   @id @default(uuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  name          String
  mobileNumber  String
  email         String?
  address       String?
  idProofType   String
  idProofNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rentals Rental[]

  @@index([branchId])
  @@index([mobileNumber])
}

model Rental {
  id               Int       @id @default(autoincrement())
  branchId         String
  branch           Branch    @relation(fields: [branchId], references: [id])
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  vehicleId        String
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  pickupDate       DateTime
  returnDate       DateTime?
  depositAmount    Float
  selectedPackage  String    @default("HOURLY") // HOURLY, 1HR, 3HR, 6HR, 12HR, 24HR
  notes            String?
  status           String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  totalHours       Float?
  totalAmount      Float?
  settlementAmount Float?    @default(0)
  isAccident       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([returnDate])
  @@index([customerId])
  @@index([vehicleId])
  @@index([branchId])
}

model MaintenanceExpense {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  date      DateTime
  amount    Float
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([vehicleId])
}

model Setting {
  id                   String   @id @default(uuid())
  currencySymbol       String   @default("₹")
  hourlyRoundingRule   String   @default("EXACT") // EXACT, ROUND_UP
  defaultDepositAmount Float    @default(0)
  companyName          String   @default("My Rental Company")
  companyAddress       String   @default("")
  companyContact       String   @default("")
  receiptFooterText    String   @default("Thank you for your business!")
  updatedAt            DateTime @updatedAt
}
